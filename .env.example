# Both optional. Without them the contact form hands the message to the
# visitor's mail client — it still delivers, but the visitor has to press send
# in their own mail app, and someone on webmail may have no handler at all.
#
# Quickest path to real inbox delivery is Web3Forms: https://web3forms.com
# Enter your email, they mail you an access key. No account, no card, free tier.
NEXT_PUBLIC_CONTACT_ENDPOINT=https://api.web3forms.com/submit
NEXT_PUBLIC_CONTACT_ACCESS_KEY=a488ae8a-2c1f-49a0-a224-17f6c7aa856c

# Formspree instead? Point the endpoint at your form and leave the key unset:
# NEXT_PUBLIC_CONTACT_ENDPOINT=https://formspree.io/f/xxxxxxxx
